<?xml version="1.0"?>
<robot name="simple_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="body_len" value="0.8" />
    <xacro:property name="body_width" value="0.6" />
    <xacro:property name="body_height" value="0.2" />
    
    <xacro:property name="wheel_radius" value="0.16" />
    <xacro:property name="wheel_width" value="0.04" />
    <xacro:property name="caster_radius" value="0.16" />
    
    <xacro:property name="suspension_travel" value="0.10" />
    <xacro:property name="mass_body" value="10.0" />
    <xacro:property name="mass_wheel" value="1.0" />
    <xacro:property name="mass_caster" value="1.0" />
    <xacro:property name="mass_suspension" value="0.4" />

    <xacro:macro name="box_inertial" params="mass x y z">
        <inertial>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0"
                     izz="${(1/12) * mass * (x*x + y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertial" params="mass r h">
        <inertial>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * mass * (3*r*r + h*h)}" iyz="0.0"
                     izz="${(1/2) * mass * r*r}" />
        </inertial>
    </xacro:macro>
    
    <xacro:macro name="sphere_inertial" params="mass r">
        <inertial>
            <mass value="${mass}" />
            <inertia ixx="${(2/5) * mass * r*r}" ixy="0.0" ixz="0.0"
                     iyy="${(2/5) * mass * r*r}" iyz="0.0"
                     izz="${(2/5) * mass * r*r}" />
        </inertial>
    </xacro:macro>

    <material name="blue"><color rgba="0.0 0.4 0.8 1.0"/></material>
    <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>

    <link name="dummy_root"/>
    <joint name="dummy_joint" type="fixed">
        <parent link="dummy_root"/>
        <child link="base_link"/>
    </joint>

    <!-- Base Link -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="${body_len} ${body_width} ${body_height}"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="${body_len} ${body_width} ${body_height}"/></geometry>
        </collision>
        <xacro:box_inertial mass="${mass_body}" x="${body_len}" y="${body_width}" z="${body_height}" />
    </link>

    <!-- IMU Sensor Link -->
    <link name="imu_link"/>
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>50</update_rate>
            <visualize>true</visualize>
            <topic>/imu</topic>
        </sensor>
    </gazebo>

    <!-- Suspension Macro -->
    <xacro:macro name="suspension" params="prefix xyz_offset">
        <link name="suspension_${prefix}_link">
            <visual>
                <geometry><box size="0.04 0.04 0.10"/></geometry>
                <material name="grey"/>
            </visual>
            <xacro:box_inertial mass="${mass_suspension}" x="0.04" y="0.04" z="0.10"/>
        </link>
        
        <joint name="suspension_${prefix}_joint" type="prismatic">
            <parent link="base_link"/>
            <child link="suspension_${prefix}_link"/>
            <origin xyz="${xyz_offset}" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="-${suspension_travel}" upper="${suspension_travel}" effort="500.0" velocity="10.0"/>
            <!-- Add spring and damping -->
            <dynamics damping="50.0" friction="0.1" spring_stiffness="2000.0" spring_reference="0.0"/>
        </joint>
    </xacro:macro>

    <!-- Rear Wheels Macro (Driven) -->
    <xacro:macro name="rear_wheel" params="prefix xyz_offset">
        <xacro:suspension prefix="${prefix}" xyz_offset="${xyz_offset}"/>
        
        <link name="wheel_${prefix}_link">
            <visual>
                <origin rpy="${pi/2} 0 0"/>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <material name="black"/>
            </visual>
            <collision>
                <origin rpy="${pi/2} 0 0"/>
                <!-- Using cylinder or sphere for stability -->
                <geometry><sphere radius="${wheel_radius}"/></geometry>
            </collision>
            <xacro:cylinder_inertial mass="${mass_wheel}" r="${wheel_radius}" h="${wheel_width}"/>
        </link>

        <joint name="wheel_${prefix}_joint" type="continuous">
            <parent link="suspension_${prefix}_link"/>
            <child link="wheel_${prefix}_link"/>
            <origin xyz="0 0 -0.10" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit effort="500.0" velocity="50.0"/>
            <dynamics damping="0.1" friction="0.05"/>
        </joint>

        <gazebo reference="wheel_${prefix}_link">
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
        </gazebo>
    </xacro:macro>

    <!-- Front Casters Macro (Passive, slide balls) -->
    <xacro:macro name="front_caster" params="prefix xyz_offset">
        <xacro:suspension prefix="${prefix}" xyz_offset="${xyz_offset}"/>
        
        <link name="caster_${prefix}_link">
            <visual>
                <geometry><sphere radius="${caster_radius}"/></geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry><sphere radius="${caster_radius}"/></geometry>
            </collision>
            <xacro:sphere_inertial mass="${mass_caster}" r="${caster_radius}"/>
        </link>

        <joint name="caster_${prefix}_joint" type="fixed">
            <parent link="suspension_${prefix}_link"/>
            <child link="caster_${prefix}_link"/>
            <origin xyz="0 0 -0.10" rpy="0 0 0"/>
        </joint>

        <!-- Low friction for casters -->
        <gazebo reference="caster_${prefix}_link">
            <mu1>0.0</mu1>
            <mu2>0.0</mu2>
        </gazebo>
    </xacro:macro>

    <!-- Instantiate 4 Wheels/Casters -->
    <xacro:front_caster prefix="fl" xyz_offset="0.30 0.34 -0.20"/>
    <xacro:front_caster prefix="fr" xyz_offset="0.30 -0.34 -0.20"/>
    <xacro:rear_wheel prefix="rl" xyz_offset="-0.30 0.34 -0.20"/>
    <xacro:rear_wheel prefix="rr" xyz_offset="-0.30 -0.34 -0.20"/>

    <!-- Lidar Link and Sensor -->
    <link name="lidar_link">
        <visual>
            <geometry><cylinder radius="0.05" length="0.05"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><cylinder radius="0.05" length="0.05"/></geometry>
        </collision>
        <xacro:cylinder_inertial mass="0.1" r="0.05" h="0.05"/>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.0 0 0.15" rpy="0 0 0"/>
    </joint>

    <gazebo reference="lidar_link">
        <sensor name='lidar_sensor' type='gpu_lidar'>
            <pose>0 0 0 0 0 0</pose>
            <topic>/scan</topic>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>0.01</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.08</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

    <!-- Camera Link and Sensor -->
    <link name="camera_link">
        <visual>
            <geometry><box size="0.05 0.05 0.05"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><box size="0.05 0.05 0.05"/></geometry>
        </collision>
        <xacro:box_inertial mass="0.1" x="0.05" y="0.05" z="0.05"/>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.4 0 0.1" rpy="0 0 0"/>
    </joint>

    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="camera">
            <topic>/camera/image_raw</topic>
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
            </camera>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

    <!-- Gazebo Plugins -->
    <gazebo>
        <!-- Apply Joint Force for rear wheels -->
        <!-- 原有的力控制插件 (已被注释)-->
        <plugin filename="libignition-gazebo-apply-joint-force-system.so" name="ignition::gazebo::systems::ApplyJointForce">
            <joint_name>wheel_rl_joint</joint_name>
            <joint_name>wheel_rr_joint</joint_name>
        </plugin>
        

        <!-- 使用 Joint Controller 进行速度控制 (新增) 
        <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
            <joint_name>wheel_rl_joint</joint_name>
            <initial_velocity>0.0</initial_velocity>
            <p_gain>10.0</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.0</d_gain>
        </plugin>
        
        <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
            <joint_name>wheel_rr_joint</joint_name>
            <initial_velocity>0.0</initial_velocity>
            <p_gain>10.0</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.0</d_gain>
        </plugin>
        -->
        <!-- Odometry Publisher (Provides Ground Truth position, velocity, heading) -->
        <plugin filename="libignition-gazebo-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_topic>/model/simple_car/odometry</odom_topic>
            <odom_frame>odom</odom_frame>
            <robot_base_frame>dummy_root</robot_base_frame>
            <dimensions>3</dimensions>
        </plugin>

        <!-- IMU System Plugin -->
        <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu">
        </plugin>

        <!-- Joint State Publisher (Encoders for rear wheels and suspensions) -->
        <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
            <topic>/model/simple_car/joint_states</topic>
            <joint_name>wheel_rl_joint</joint_name>
            <joint_name>wheel_rr_joint</joint_name>
            <joint_name>suspension_fl_joint</joint_name>
            <joint_name>suspension_fr_joint</joint_name>
            <joint_name>suspension_rl_joint</joint_name>
            <joint_name>suspension_rr_joint</joint_name>
        </plugin>
    </gazebo>

</robot>
