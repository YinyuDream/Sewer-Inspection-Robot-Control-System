<?xml version="1.0"?>
<robot name="pipeline_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========================================================== -->
    <!--                     1. 属性与常数定义                      -->
    <!-- ========================================================== -->
    <!-- 定义机器人各部分的尺寸、质量等参数，方便统一修改 -->
    
    <!-- 尺寸参数 (单位: 米) -->
    <xacro:property name="body_len" value="0.75" />  <!-- 车身长度: 机器人的主体框架长度 -->
    <xacro:property name="body_width" value="0.54" /> <!-- 车身宽度: 机器人的主体框架宽度 -->
    <xacro:property name="body_height" value="0.54" /> <!-- 车身高度: 机器人的主体框架高度 -->
    
    <xacro:property name="wheel_radius" value="0.18" /> <!-- 轮子半径: 驱动轮的大小 -->
    <xacro:property name="wheel_width" value="0.15" /> <!-- 轮子宽度: 驱动轮的接触面宽度 -->
    <xacro:property name="wheel_offset" value="0.35" /> <!-- 轮子离中心的偏移距离 (半宽 + 间隙) -->
    <xacro:property name="wheel_interval" value="0.25" /> <!-- 轮子距离中心轴线距离 -->
    
    <xacro:property name="leg_radius" value="0.045" /> <!-- 支撑腿半径: 伸缩腿的粗细 -->
    <xacro:property name="leg_length" value="0.45" />   <!-- 支撑腿长度: 伸缩腿的初始长度 -->

    <!-- 质量参数 (用于惯性矩阵计算) - 增加质量以增加物理仿真的稳定性 -->
    <xacro:property name="mass_body" value="20.0" />  <!-- 车身质量 -->
    <xacro:property name="mass_wheel" value="2.0" />  <!-- 轮子质量 -->
    <xacro:property name="mass_leg" value="1.0" />    <!-- 腿部质量 -->

    <!-- 材质颜色定义 (用于 RViz 可视化) -->
    <material name="blue">
        <color rgba="0.0 0.4 0.8 1.0"/>
    </material>
    <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
    </material>
    <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
    </material>
    <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
    </material>

    <!-- ========================================================== -->
    <!--                     2. 通用宏定义 (Macros)                 -->
    <!-- ========================================================== -->
    <!-- 使用宏来简化重复代码，特别是对于对称结构 -->

    <!-- 惯性矩阵宏: 盒子 -->
    <!-- 根据质量和尺寸计算盒子的转动惯量矩阵，用于Gazebo物理引擎计算 -->
    <xacro:macro name="box_inertial" params="mass x y z">
        <inertial>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0"
                     izz="${(1/12) * mass * (x*x + y*y)}" />
        </inertial>
    </xacro:macro>

    <!-- 惯性矩阵宏: 圆柱 -->
    <!-- 根据质量、半径和高度计算圆柱体的转动惯量矩阵 (假设圆柱轴沿Z轴) -->
    <xacro:macro name="cylinder_inertial" params="mass r h">
        <inertial>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * mass * (3*r*r + h*h)}" iyz="0.0"
                     izz="${(1/2) * mass * r*r}" />
        </inertial>
    </xacro:macro>

    <!-- ========================================================== -->
    <!--               3. 驱动节 (Drive Section - Right)            -->
    <!-- ========================================================== -->

    <!-- Base Link: 机器人的主体 (驱动节盒子) -->
    <!-- 它是整个机器人的根坐标系 -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="${pi/4} 0 0"/>
            <geometry>
                <box size="${body_len} ${body_width} ${body_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="${pi/4} 0 0"/>
            <geometry>
                <box size="${body_len} ${body_width} ${body_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertial mass="${mass_body}" x="${body_len}" y="${body_width}" z="${body_height}" />
    </link>

    <!-- 驱动轮宏定义 (带伸缩) -->
    <!-- 创建一个带有伸缩机构和两个驱动轮（前后）的组件 -->
    <!-- 参数: location(位置名称: top/bottom/left/right), xyz_offset(初始位置), rpy_offset(旋转), axis_dir(伸缩方向) -->
    <xacro:macro name="expandable_drive_wheel" params="location xyz_offset rpy_offset">
        
        <!-- 伸缩腿连杆: 连接主体和轮架的中间件 -->
        <link name="drive_leg_${location}_link">
            <visual>
                <geometry><box size="0.05 0.05 0.1"/></geometry> <!-- 简单的腿部形状 -->
                <origin xyz="0 0 0.05" rpy="0 0 0"/>
                <material name="grey"/>
            </visual>
            <xacro:box_inertial mass="0.2" x="0.05" y="0.05" z="0.1"/>
        </link>

        <!-- 伸缩关节: 棱柱关节 (prismatic)，允许沿Z轴直线移动 -->
        <joint name="drive_expansion_joint_${location}" type="prismatic">
            <parent link="base_link"/>
            <child link="drive_leg_${location}_link"/>
            <origin xyz="${xyz_offset}" rpy="${rpy_offset}"/>
            <axis xyz="0 0 1"/> <!-- 沿局部Z轴伸缩 -->
            <limit lower="0.0" upper="0.8" effort="5000.0" velocity="0.5"/>
            <dynamics damping="5.0" friction="0.5"/> <!-- 增加阻尼和摩擦以模拟真实物理特性 -->
        </joint>

        <!-- Drive Expansion Plugin (Drive Section) - Velocity Control (Restored) -->
        <gazebo>
            <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
                <joint_name>drive_expansion_joint_${location}</joint_name>
                <i_max>1000</i_max>
                <i_min>-1000</i_min>
            </plugin>
        </gazebo>

        <!-- Bogie Link (转向架/轮架): 连接两个轮子的支架 -->
        <link name="drive_bogie_${location}_link">
            <visual>
                <geometry><box size="0.6 0.05 0.05"/></geometry>
                <material name="grey"/>
            </visual>
            <xacro:box_inertial mass="0.5" x="0.6" y="0.05" z="0.05"/>
        </link>

        <!-- 固定关节连接腿和轮架 -->
        <joint name="drive_bogie_joint_${location}" type="fixed">
            <parent link="drive_leg_${location}_link"/>
            <child link="drive_bogie_${location}_link"/>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
        </joint>

        <!-- Front Wheel (前轮) -->
        <link name="drive_wheel_${location}_front_link">
            <visual>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <origin rpy="${pi/2} 0 0"/> <!-- 旋转圆柱体使其平躺为车轮状 -->
                <material name="black"/>
            </visual>
            <collision>
                <geometry><sphere radius="${wheel_radius}"/></geometry> <!-- 使用球体碰撞优化物理计算稳定性 -->
                <origin rpy="${pi/2} 0 0"/>
            </collision>
            <xacro:cylinder_inertial mass="${mass_wheel}" r="${wheel_radius}" h="${wheel_width}"/>
        </link>

        <!-- Gazebo 物理属性: 高摩擦力，防止打滑 -->
        <gazebo reference="drive_wheel_${location}_front_link">
            <mu1>4.0</mu1>
            <mu2>4.0</mu2>
            <kp>10000.0</kp>
            <kd>5.0</kd>
            <minDepth>0.001</minDepth>
        </gazebo>

        <!-- 轮子驱动关节: 连续旋转关节 -->
        <joint name="drive_wheel_${location}_front_joint" type="continuous">
            <parent link="drive_bogie_${location}_link"/>
            <child link="drive_wheel_${location}_front_link"/>
            <origin xyz="${wheel_interval} 0 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/> <!-- 绕Y轴旋转 -->
            <limit effort="1000.0" velocity="20.0"/>
            <dynamics damping="0.5" friction="0.2"/>
        </joint>

        <!-- Rear Wheel (后轮) - 结构同前轮 -->
        <link name="drive_wheel_${location}_rear_link">
            <visual>
                <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
                <origin rpy="${pi/2} 0 0"/>
                <material name="black"/>
            </visual>
            <collision>
                <geometry><sphere radius="${wheel_radius}"/></geometry>
                <origin rpy="${pi/2} 0 0"/>
            </collision>
            <xacro:cylinder_inertial mass="${mass_wheel}" r="${wheel_radius}" h="${wheel_width}"/>
        </link>

        <gazebo reference="drive_wheel_${location}_rear_link">
            <mu1>4.0</mu1>
            <mu2>4.0</mu2>
            <kp>10000.0</kp>
            <kd>5.0</kd>
            <minDepth>0.001</minDepth>
        </gazebo>

        <joint name="drive_wheel_${location}_rear_joint" type="continuous">
            <parent link="drive_bogie_${location}_link"/>
            <child link="drive_wheel_${location}_rear_link"/>
            <origin xyz="-${wheel_interval} 0 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit effort="1000.0" velocity="20.0"/>
            <dynamics damping="0.5" friction="0.2"/>
        </joint>
    </xacro:macro>

    <!-- 实例化4个可伸缩驱动轮组件 -->
    
    <!-- Top Wheel (顶部轮组) -->
    <xacro:expandable_drive_wheel location="top" xyz_offset="0 ${wheel_offset} ${wheel_offset}" rpy_offset="-${pi/4} 0 0"/>

    <!-- Bottom Wheel (底部轮组, 翻转180度) -->
    <xacro:expandable_drive_wheel location="bottom" xyz_offset="0 ${wheel_offset} -${wheel_offset}" rpy_offset="-${3*pi/4} 0 0"/>

    <!-- Left Wheel (左侧轮组, 翻转-90度) -->
    <xacro:expandable_drive_wheel location="left" xyz_offset="0 -${wheel_offset} ${wheel_offset}" rpy_offset="${pi/4} 0 0"/>

    <!-- Right Wheel (右侧轮组, 翻转90度) -->
    <xacro:expandable_drive_wheel location="right" xyz_offset="0 -${wheel_offset} -${wheel_offset}" rpy_offset="${3*pi/4} 0 0"/>



    <!-- ========================================================== -->
    <!--             4. 机械臂连接节 (Joint Section - Middle)       -->
    <!-- ========================================================== -->
    <!-- 连接前后两部分车身的万向节结构 -->

    <!-- 中间虚拟连接杆 (Universal Joint Center) -->
    <link name="universal_joint_link">
        <visual>
            <geometry><sphere radius="0.08"/></geometry>
            <material name="grey"/>
        </visual>
        <xacro:box_inertial mass="0.5" x="0.1" y="0.1" z="0.1"/>
    </link>

    <!-- 关节1: Pitch (俯仰 - 绕Y轴) -->
    <joint name="joint_pitch" type="revolute">
        <parent link="base_link"/>
        <child link="universal_joint_link"/>
        <origin xyz="-${body_len/2 + 0.12} 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="100.0" velocity="0.5"/>
        <dynamics damping="3.0" friction="0.2"/>
    </joint>

    <!-- 功能节的主体基座 -->
    <link name="func_base_link">
        <visual>
            <origin xyz="-${body_len/2} 0 0" rpy="0 0 0"/> <!-- Offset geometry to start after joint -->
            <geometry>
                <box size="${body_len} ${body_width} ${body_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="-${body_len/2} 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${body_len} ${body_width} ${body_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertial mass="${mass_body}" x="${body_len}" y="${body_width}" z="${body_height}" />
    </link>

    <!-- 关节2: Yaw (偏航 - 绕Z轴) -->
    <joint name="joint_yaw" type="revolute">
        <parent link="universal_joint_link"/>
        <child link="func_base_link"/>
        <origin xyz="-0.12 0 0" rpy="${pi/4} 0 0"/>
        <axis xyz="0 ${pi/4} ${pi/4}"/>
        <limit lower="-1.57" upper="1.57" effort="100.0" velocity="0.5"/>
        <dynamics damping="3.0" friction="0.2"/>
    </joint>


    <!-- ========================================================== -->
    <!--            5. 功能节 (Functional Section - Left)           -->
    <!-- ========================================================== -->
    <!-- 后半部分，配有被动轮和伸缩机构，用于支撑和随动 -->

    <!-- 伸缩腿宏定义 (Prismatic Leg + Passive Wheel) -->
    <!-- 参数: suffix(名称后缀), xyz_offset(位置), rpy_offset(旋转) -->
    <xacro:macro name="expansion_leg" params="suffix xyz_offset rpy_offset axis_dir">
        
        <!-- 腿部连杆 -->
        <link name="leg_${suffix}_link">
            <visual>
                <geometry>
                    <cylinder radius="${leg_radius}" length="${leg_length}"/>
                </geometry>
                <!-- 腿沿着Z轴方向 -->
                <origin xyz="0 0 ${leg_length/2}" rpy="0 0 0"/>
                <material name="orange"/>
            </visual>
            <collision>
                 <geometry>
                    <cylinder radius="${leg_radius}" length="${leg_length}"/>
                </geometry>
                <origin xyz="0 0 ${leg_length/2}" rpy="0 0 0"/>
            </collision>
            <xacro:cylinder_inertial mass="${mass_leg}" r="${leg_radius}" h="${leg_length}"/>
        </link>

        <!-- 伸缩关节 (Prismatic) - 模拟剪叉张开 -->
        <joint name="expansion_joint_${suffix}" type="prismatic">
            <parent link="func_base_link"/>
            <child link="leg_${suffix}_link"/>
            <origin xyz="${xyz_offset}" rpy="${rpy_offset}"/>
            <!-- 沿着局部坐标系的Z轴伸缩 -->
            <axis xyz="0 0 1"/> 
            <limit lower="0.0" upper="0.8" effort="5000.0" velocity="0.5"/>
            <dynamics damping="5.0" friction="0.5"/>
        </joint>

        <!-- Expansion Joint Plugin (Functional Section) - Velocity Control (Restored) -->
         <gazebo>
            <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
                <joint_name>expansion_joint_${suffix}</joint_name>
                <i_max>1000</i_max>
                <i_min>-1000</i_min>
            </plugin>
         </gazebo>

        <!-- Bogie Link (连接两个轮子的支架) -->
        <link name="passive_bogie_${suffix}_link">
            <visual>
                <geometry><box size="0.4 0.05 0.05"/></geometry>
                <material name="grey"/>
            </visual>
            <xacro:box_inertial mass="0.5" x="0.4" y="0.05" z="0.05"/>
        </link>

        <joint name="passive_bogie_joint_${suffix}" type="fixed">
            <parent link="leg_${suffix}_link"/>
            <child link="passive_bogie_${suffix}_link"/>
            <origin xyz="0 0 ${leg_length}" rpy="0 0 0"/>
        </joint>

        <!-- Front Passive Wheel (前被动轮) - 使用球形万向轮简化 -->
        <link name="passive_wheel_${suffix}_front_link">
            <visual>
                <geometry><sphere radius="0.04"/></geometry>
                <material name="black"/>
            </visual>
             <collision>
                <geometry><sphere radius="0.04"/></geometry>
            </collision>
            <xacro:box_inertial mass="0.1" x="0.08" y="0.08" z="0.08"/>
        </link>

        <!-- 被动轮几乎无摩擦，为了让它顺滑移动 -->
        <gazebo reference="passive_wheel_${suffix}_front_link">
            <mu1>0.001</mu1>
            <mu2>0.001</mu2>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
        </gazebo>

        <joint name="passive_wheel_joint_${suffix}_front" type="continuous">
            <parent link="passive_bogie_${suffix}_link"/>
            <child link="passive_wheel_${suffix}_front_link"/>
            <origin xyz="0.15 0 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

        <!-- Rear Passive Wheel (后被动轮) -->
        <link name="passive_wheel_${suffix}_rear_link">
            <visual>
                <geometry><sphere radius="0.04"/></geometry>
                <material name="black"/>
            </visual>
             <collision>
                <geometry><sphere radius="0.04"/></geometry>
            </collision>
            <xacro:box_inertial mass="0.1" x="0.08" y="0.08" z="0.08"/>
        </link>

        <gazebo reference="passive_wheel_${suffix}_rear_link">
            <mu1>0.001</mu1>
            <mu2>0.001</mu2>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
        </gazebo>

        <joint name="passive_wheel_joint_${suffix}_rear" type="continuous">
            <parent link="passive_bogie_${suffix}_link"/>
            <child link="passive_wheel_${suffix}_rear_link"/>
            <origin xyz="-0.15 0 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

    </xacro:macro>

    <!-- 实例化4个伸缩腿 -->
    
    <!-- Top Leg (朝上 +Z) -->
    <xacro:expansion_leg suffix="top" xyz_offset="-${body_len/2} 0 ${body_height/2}" rpy_offset="0 0 0" axis_dir="0 0 1"/>

    <!-- Bottom Leg (朝下 -Z) -> 旋转180度使Z轴朝下 -->
    <xacro:expansion_leg suffix="bottom" xyz_offset="-${body_len/2} 0 -${body_height/2}" rpy_offset="${pi} 0 0" axis_dir="0 0 1"/>

    <!-- Left Leg (朝左 +Y) -> 绕X轴转-90度使Z轴朝左 -->
    <xacro:expansion_leg suffix="left" xyz_offset="-${body_len/2} ${body_width/2} 0" rpy_offset="-${pi/2} 0 0" axis_dir="0 0 1"/>

    <!-- Right Leg (朝右 -Y) -> 绕X轴转+90度使Z轴朝右 -->
    <xacro:expansion_leg suffix="right" xyz_offset="-${body_len/2} -${body_width/2} 0" rpy_offset="${pi/2} 0 0" axis_dir="0 0 1"/>

    <!-- ========================================================== -->
    <!--                     6. Gazebo Plugins                      -->
    <!-- ========================================================== -->
    <gazebo>
        <!-- Drive Wheels Controller (驱动轮控制器) -->
        <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
            <joint_name>drive_wheel_top_front_joint</joint_name>
            <joint_name>drive_wheel_top_rear_joint</joint_name>
            <joint_name>drive_wheel_bottom_front_joint</joint_name>
            <joint_name>drive_wheel_bottom_rear_joint</joint_name>
            <joint_name>drive_wheel_left_front_joint</joint_name>
            <joint_name>drive_wheel_left_rear_joint</joint_name>
            <joint_name>drive_wheel_right_front_joint</joint_name>
            <joint_name>drive_wheel_right_rear_joint</joint_name>
            <initial_velocity>0.0</initial_velocity>
        </plugin>

        <!-- Expansion Joints Controller Removed (Moved to macros) -->

        <!-- Odometry Publisher (里程计发布) -->
        <plugin filename="libignition-gazebo-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_topic>/model/simple_car_v2/odometry</odom_topic>
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <dimensions>3</dimensions>
        </plugin>
        
        <!-- IMU Plugin -->
        <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu">
        </plugin>

    </gazebo>

</robot>